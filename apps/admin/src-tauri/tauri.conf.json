{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 820,
        "minHeight": 680,
        "minWidth": 960,
        "title": "WinPassageAdmin",
        "width": 1180
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "aube run build",
    "beforeDevCommand": "aube run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": "all"
  },
  "identifier": "net.datarose.winpassage.admin",
  "productName": "WinPassageAdmin",
  "version": "0.4.0"
}
