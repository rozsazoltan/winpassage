{
  "name": "winpassage",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "dev:admin": "pnpm --filter winpassage-admin tauri:dev",
    "dev:client": "pnpm --filter winpassage-client tauri:dev",
    "build:admin": "pnpm --filter winpassage-admin tauri:build",
    "build:client": "pnpm --filter winpassage-client tauri:build",
    "build:server": "cargo build --release -p winpassage-server",
    "build:agentctl": "cargo build --release -p winpassage-agentctl",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --workspace",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:js": "pnpm --recursive run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/rozsazoltan/winpassage.git"
  },
  "bugs": {
    "url": "https://github.com/rozsazoltan/winpassage/issues"
  },
  "homepage": "https://github.com/rozsazoltan/winpassage#readme",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
